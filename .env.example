# ====================
# Node
# ====================
NODE_ENV=development

# ====================
# Database (Postgres)
# ====================
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot
POSTGRES_DB=jobpilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobpilot:jobpilot@localhost:5432/jobpilot?schema=public

# ====================
# Redis
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ====================
# API Server
# ====================
API_PORT=4000
API_HOST=0.0.0.0
API_URL=http://localhost:4000
API_VERSION=v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ====================
# Frontend (Next.js)
# ====================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====================
# Clerk Auth
# ====================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ====================
# Gemini AI (also powers match engine)
# ====================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_MATCH_MODEL=gemini-flash-latest
AI_CACHE_TTL_SECONDS=604800
AI_MAX_RESUME_CHARS=12000
AI_MAX_JOB_CHARS=8000
AI_MATCH_CONCURRENCY=4

# ====================
# Scraping (Playwright)
# ====================
SCRAPER_TIMEOUT_MS=30000
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; JobPilotBot/1.0)
SCRAPER_HEADLESS=true
SCRAPER_SCHEDULER_ENABLED=false

# Public job-board feeds (Remotive, Arbeitnow)
FEEDS_ENABLED=true
FEED_SYNC_INTERVAL_HOURS=6

# Run queue workers inside the API process (single-instance/free hosting)
RUN_WORKERS=false

# Per-user cap on AI jobs of each kind per hour
AI_JOBS_PER_HOUR=30

# ====================
# Resume storage (S3-compatible: AWS S3, MinIO, R2)
# Browser uploads use presigned PUTs — the bucket needs a CORS rule for your web origin.
# ====================
S3_REGION=us-east-1
S3_BUCKET=
# S3_ENDPOINT=http://localhost:9000   (set for MinIO/R2; leave unset for AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
RESUME_MAX_BYTES=15728640
RESUME_URL_TTL_SECONDS=900
RESUME_PARSE_CONCURRENCY=2
RESUME_AI_CONCURRENCY=4
GEMINI_RESUME_MODEL=gemini-flash-latest

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ====================
# Observability
# ====================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
